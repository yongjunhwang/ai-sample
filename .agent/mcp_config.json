{
  "mcpServers": {
    "unity-mcp": {
      "command": "cmd",
      "args": [
        "/c",
        "%USERPROFILE%\\.unity\\relay\\relay_win.exe",
        "--mcp"
      ]
    },
    "unityMCP": {
      "url": "http://localhost:8080/mcp"
    },
    "blender": {
      "command": "uvx",
      "args": [
        "mcp-for-blender"
      ]
    }
  }
}
